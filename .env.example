# Copy the provider values into your private .env. Never commit real keys.
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Explicit local LiveKit profile; existing LIVEKIT_* cloud values are not used.
TURNLAB_LIVEKIT_URL=ws://127.0.0.1:7880
TURNLAB_LIVEKIT_API_KEY=devkey
TURNLAB_LIVEKIT_API_SECRET=secret

# Configurable baseline models; not benchmark winners.
TURNLAB_LLM_MODEL=openai/gpt-oss-20b
TURNLAB_STT_MODEL=nova-3
TURNLAB_STT_LANGUAGE=en
TURNLAB_TTS_MODEL=aura-2-thalia-en

# Inject isolated demo tool failures only when explicitly enabled.
TURNLAB_DEMO_FAULTS=false

# A reply is "slow" when the caller waits longer than this after they stop speaking.
TURNLAB_SLOW_REPLY_MS=2000

# Optional: send LiveKit's built-in OpenTelemetry traces to Langfuse, SigNoz, Phoenix, Grafana...
# Use the backend's OTLP/HTTP traces URL; put its auth in the standard OTEL_EXPORTER_OTLP_HEADERS.
# Conversation text and tool payloads are stripped unless TURNLAB_OTEL_INCLUDE_CONVERSATION=true.
TURNLAB_OTEL_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
TURNLAB_OTEL_INCLUDE_CONVERSATION=false

# Optional hosted metadata replication. Keep these backend-only, never VITE_*.
# Apply supabase/migrations/202610150001_turnlab_runs.sql before enabling.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TURNLAB_WORKSPACE=local
