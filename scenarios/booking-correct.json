    {"id": "correct-arguments", "kind": "tool_called", "name": "book_visit", "arguments": {"day": "Friday"}, "count": 1},
    {"id": "correct-booking", "kind": "state_equals", "key": "booking_day", "expected": "Friday"},
    {"id": "one-side-effect", "kind": "state_equals", "key": "booking_count", "expected": 1}
  ]
